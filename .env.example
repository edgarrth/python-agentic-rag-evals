# Entorno: local | test | docker
APP_ENV=local
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Bind del backend. En host se recomienda 0.0.0.0 para WSL.
HOST=0.0.0.0
BACKEND_PORT=8000
# URL usada por Promptfoo al consumir el backend.
# Host: http://localhost:8000 | Docker Compose: http://backend:8000
BACKEND_URL=http://localhost:8000

# Qdrant. Host: http://localhost:6333 | Docker Compose: http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=axiz_payment_evals_chunks
# Memgraph. Host: bolt://localhost:7687 | Docker Compose: bolt://memgraph:7687
MEMGRAPH_URI=bolt://localhost:7687
# Vacío significa autenticación deshabilitada en la PoC.
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Proveedor de embeddings implementado en esta PoC: hashing
# hashing es determinista, offline y reproducible para que el benchmark compare RAG sin variar el embedding.
EMBEDDING_PROVIDER=hashing
# Debe coincidir con la dimensión de la colección Qdrant cuando se usa hashing.
EMBEDDING_DIMENSIONS=384
# Proveedor de generación: deterministic | openai
GENERATION_PROVIDER=openai
# Proveedor de juez: deterministic | openai
JUDGE_PROVIDER=openai
# Clave requerida solo cuando se habilita generación OpenAI o jueces externos.
OPENAI_API_KEY=
# Endpoint compatible con OpenAI Responses API. Valor habitual: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Modelo OpenAI por defecto. Debe existir en la cuenta configurada.
OPENAI_MODEL=gpt-5.4-mini
# Modelos SUT mostrados en el combobox. Los Mini se listan primero y son la opción por defecto.
# Mini: gpt-5.4-mini | gpt-4.1-mini | gpt-4o-mini
# Normales/eficientes: gpt-6-luna | gpt-5.6-luna | gpt-5.6-terra | gpt-5.4 | gpt-5.6-sol | gpt-6.1-sol | gpt-6-astra
# La disponibilidad final depende de los modelos habilitados para la cuenta OpenAI usada.
OPENAI_MODELS=gpt-5.4-mini,gpt-4.1-mini,gpt-4o-mini,gpt-6-luna,gpt-5.6-luna,gpt-5.6-terra,gpt-5.4,gpt-5.6-sol,gpt-6.1-sol,gpt-6-astra
# Modelo Judge por defecto. Se deja Mini por conveniencia/costo; para una evaluación final puede elegirse un modelo normal más capaz.
OPENAI_JUDGE_MODEL=gpt-5.4-mini
# Modelos permitidos para LLM-as-a-Judge. Los Mini se listan primero; también se exponen los normales.
OPENAI_JUDGE_MODELS=gpt-5.4-mini,gpt-4.1-mini,gpt-4o-mini,gpt-6-luna,gpt-5.6-luna,gpt-5.6-terra,gpt-5.4,gpt-5.6-sol,gpt-6.1-sol,gpt-6-astra

# Suite por defecto: smoke | rag | agentic | safety | voice | full
EVAL_DEFAULT_SUITE=full
# Concurrencia máxima recomendada: entero >= 1. Para la PoC se usa 4.
EVAL_CONCURRENCY=4
# Juez externo: true | false. false mantiene las pruebas totalmente reproducibles/offline.
EVAL_JUDGE_ENABLED=true
# Habilita adaptadores instalados: true | false
PROMPTFOO_ENABLED=true
DEEPEVAL_ENABLED=true
RAGAS_ENABLED=true

# Tarifas estimadas de referencia por millón de tokens. Ajustables según el proveedor/modelo usado.
ESTIMATED_INPUT_COST_PER_MILLION=1.25
ESTIMATED_OUTPUT_COST_PER_MILLION=10.0
# Presupuesto técnico de timeout en segundos.
REQUEST_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=8
# Máximo top-k permitido: 1..10
MAX_TOP_K=10
