FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements/runtime.txt /tmp/runtime.txt
RUN python -m pip install --upgrade pip && python -m pip install -r /tmp/runtime.txt

LABEL org.opencontainers.image.title="Axiz Payments Evals Python Base" \
      org.opencontainers.image.version="1.0.0"
