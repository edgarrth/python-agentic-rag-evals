# Entorno: local | test | docker
APP_ENV=local
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Bind del backend. En host se recomienda 0.0.0.0 para WSL.
HOST=0.0.0.0
BACKEND_PORT=8000
# URL usada por Promptfoo al consumir el backend.
# Host: http://localhost:8000 | Docker Compose: http://backend:8000
BACKEND_URL=http://localhost:8000

# Qdrant. Host: http://localhost:6333 | Docker Compose: http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=axiz_payment_evals_chunks
# Memgraph. Host: bolt://localhost:7687 | Docker Compose: bolt://memgraph:7687
MEMGRAPH_URI=bolt://localhost:7687
# Vacío significa autenticación deshabilitada en la PoC.
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Proveedor de embeddings: hashing | openai
# hashing es determinista, offline y reproducible; openai requiere OPENAI_API_KEY.
EMBEDDING_PROVIDER=hashing
# Debe coincidir con la dimensión de la colección Qdrant cuando se usa hashing.
EMBEDDING_DIMENSIONS=384
# Proveedor de generación: deterministic | openai
GENERATION_PROVIDER=deterministic
# Proveedor de juez: deterministic | openai
JUDGE_PROVIDER=deterministic
# Clave requerida solo cuando se habilita un proveedor OpenAI o jueces externos.
OPENAI_API_KEY=
# Modelo de generación/juez. Se puede sustituir por un modelo disponible en la cuenta.
OPENAI_MODEL=gpt-5.6-mini
# Modelo de embeddings cuando EMBEDDING_PROVIDER=openai.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Suite por defecto: smoke | rag | agentic | safety | voice | full
EVAL_DEFAULT_SUITE=full
# Concurrencia máxima recomendada: entero >= 1. Para la PoC se usa 4.
EVAL_CONCURRENCY=4
# Juez externo: true | false. false mantiene las pruebas totalmente reproducibles/offline.
EVAL_JUDGE_ENABLED=false
# Habilita adaptadores instalados: true | false
PROMPTFOO_ENABLED=true
DEEPEVAL_ENABLED=true
RAGAS_ENABLED=true

# Tarifas estimadas de referencia por millón de tokens. Ajustables según el proveedor/modelo usado.
ESTIMATED_INPUT_COST_PER_MILLION=1.25
ESTIMATED_OUTPUT_COST_PER_MILLION=10.0
# Presupuesto técnico de timeout en segundos.
REQUEST_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=8
# Máximo top-k permitido: 1..10
MAX_TOP_K=10
